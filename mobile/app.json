{
  "expo": {
    "name": "Bleje Pronën",
    "slug": "blejepronen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "blejepronen",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#00675B",
    "splash": {
      "image": "./assets/images/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#00675B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blejepronen.app",
      "backgroundColor": "#00675B",
      "splash": {
        "image": "./assets/images/splash-logo.png",
        "imageWidth": 250,
        "resizeMode": "contain",
        "backgroundColor": "#00675B",
        "tabletBackgroundColor": "#00675B",
        "dark": {
          "image": "./assets/images/splash-logo.png",
          "backgroundColor": "#00675B",
          "tabletBackgroundColor": "#00675B"
        }
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Bleje Pronën përdor Face ID për kyçje të sigurt dhe të shpejtë në llogarinë tuaj."
      }
    },
    "android": {
      "backgroundColor": "#00675B",
      "splash": {
        "image": "./assets/images/splash-logo.png",
        "imageWidth": 250,
        "resizeMode": "contain",
        "backgroundColor": "#00675B",
        "dark": {
          "image": "./assets/images/splash-logo.png",
          "backgroundColor": "#00675B"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#00675B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.blejepronen.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.WAKE_LOCK",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#00675B",
          "dark": {
            "image": "./assets/images/splash-logo.png",
            "imageWidth": 250,
            "backgroundColor": "#00675B"
          },
          "android": {
            "image": "./assets/images/splash-logo.png",
            "imageWidth": 250,
            "resizeMode": "contain",
            "backgroundColor": "#00675B",
            "dark": {
              "image": "./assets/images/splash-logo.png",
              "backgroundColor": "#00675B"
            }
          },
          "ios": {
            "image": "./assets/images/splash-logo.png",
            "imageWidth": 250,
            "resizeMode": "contain",
            "backgroundColor": "#00675B",
            "dark": {
              "image": "./assets/images/splash-logo.png",
              "backgroundColor": "#00675B"
            }
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Bleje Pronën ju lejon të telefononi direk në aplikacion me shitësin/blerësin (thirrje zanore falas)."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bleje Pronën përdor galerinë tuaj për të shtuar fotot e banesës dhe foton e profilit.",
          "cameraPermission": "Bleje Pronën përdor kamerën për të fotografuar banesësn që po postoni."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Bleje Pronën përdor Face ID për kyçje të sigurt dhe të shpejtë në llogarinë tuaj."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}