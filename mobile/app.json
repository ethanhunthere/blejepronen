{
  "expo": {
    "name": "Bleje Pronën",
    "slug": "blejepronen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "blejepronen",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blejepronen.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#006459",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.blejepronen.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#006459"
        }
      ],
      ["@config-plugins/react-native-webrtc", {
        "microphonePermission": "Bleje Pronën ju lejon të telefononi direk në aplikacion me shitësin/blerësin (thirrje zanore falas)."
      }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
