# ============================================================================
# BLEJE PRONËN — AUTONOMOUS AGENT SWARM ENVIRONMENT CONFIGURATION
# File: .env.swarm.example
#
# Dedicated server-side secrets for Master Orchestrator Thanos and the 10
# Marvel child agents. Never commit active keys. Never bundle into client code.
# ============================================================================

# Target Platform URLs
SWARM_TARGET_WEB_URL=https://blejepronen.com
SWARM_TARGET_API_URL=https://blejepronen.com/api
SWARM_CRON_SECRET=your_vercel_or_backend_cron_secret

# Supabase Backend Access
# Service role key is required for Thanos to write to agent_incidents & agent_heartbeats
# and inspect telemetry_events across RLS barriers.
SWARM_SUPABASE_URL=https://your-project.supabase.co
SWARM_SUPABASE_SERVICE_ROLE_KEY=eyJh...
SWARM_SUPABASE_ANON_KEY=eyJh...
SWARM_DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# GitHub Integration (Required for Agent 1 - Iron Man to open PRs & verify branches)
SWARM_GITHUB_TOKEN=ghp_your_github_personal_access_token_or_app_token
SWARM_GITHUB_REPO=ethanhunthere/blejepronen
SWARM_GIT_WORKING_DIR=/home/f0id/Downloads/blejepronen

# Alerting Channels (Instant Push Alerts for P1 & P2 Incidents)
SWARM_TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
SWARM_TELEGRAM_CHAT_ID=-1001234567890
SWARM_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# AI Engine (Root Cause Analysis & CodeDoctor Surgical Patch Synthesis)
SWARM_GEMINI_API_KEY=AIzaSy...
# Optional alternative provider:
# SWARM_OPENAI_API_KEY=sk-...

# Swarm Operational Tuning
SWARM_ENVIRONMENT=production
SWARM_LOG_LEVEL=info
SWARM_HEARTBEAT_INTERVAL_MS=30000
SWARM_DEDUP_WINDOW_MS=3600000
SWARM_MAX_CRASH_RETRIES=5
SWARM_CIRCUIT_BREAKER_WINDOW_MS=300000
